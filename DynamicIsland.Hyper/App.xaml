<Application x:Class="DynamicIsland.Hyper.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- 主题画刷：默认日间（浅色），由 ThemeManager 按时间动态替换 -->
        <SolidColorBrush x:Key="Theme.Foreground" Color="#FF1B1B1B" />
        <SolidColorBrush x:Key="Theme.Muted"     Color="#FF5F5F5F" />
        <SolidColorBrush x:Key="Theme.Border"    Color="#40000000" />
        <SolidColorBrush x:Key="Theme.Overlay"   Color="#E6F5F5F7" />
    </Application.Resources>
</Application>
