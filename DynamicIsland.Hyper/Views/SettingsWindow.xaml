<Window x:Class="DynamicIsland.Hyper.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hyper 灵动岛 · 设置"
        Width="420" Height="560"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontSize="13"
        Background="#FFFFFF">
    <Window.Resources>
        <!-- 主题色 -->
        <SolidColorBrush x:Key="Accent" Color="#4F8CFF"/>
        <SolidColorBrush x:Key="Card" Color="#F7F8FA"/>
        <SolidColorBrush x:Key="CardBorder" Color="#ECEEF3"/>
        <SolidColorBrush x:Key="TextStrong" Color="#1B1B1B"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8A8F99"/>

        <!-- 分区卡片 -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- 分组标题 -->
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextStrong}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- 字段标签 -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>

        <!-- 圆角下拉框 -->
        <Style x:Key="RoundCombo" TargetType="ComboBox">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
        </Style>

        <!-- 现代滑块：细轨道 + 圆形手柄 -->
        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="6" CornerRadius="3" Background="#ECEEF3"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Height="6" CornerRadius="3" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Height="6" CornerRadius="3" Background="#ECEEF3"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="18" Height="18">
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Ellipse Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}"
                                                         Stroke="White" StrokeThickness="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 头部 -->
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Hyper 灵动岛" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextStrong}"/>
                <TextBlock Text="DynamicIsland.Hyper · 设置" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <!-- 内容区（可滚动） -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
            <StackPanel>

                <!-- 主题 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="主题" Style="{StaticResource GroupTitle}"/>
                        <TextBlock Text="模式" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="ThemeModeBox" Style="{StaticResource RoundCombo}">
                            <ComboBoxItem Content="自动（按时间）"/>
                            <ComboBoxItem Content="强制浅色"/>
                            <ComboBoxItem Content="强制深色"/>
                        </ComboBox>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="日间开始" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="DayStartBox" Style="{StaticResource RoundCombo}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="夜间开始" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="NightStartBox" Style="{StaticResource RoundCombo}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 系统 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="系统" Style="{StaticResource GroupTitle}"/>
                        <CheckBox x:Name="AutoStartCheck" Content="开机自启" Margin="0,8,0,0"/>
                        <CheckBox x:Name="AutoUpdateCheck" Content="启动时检查更新" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 霓虹 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="霓虹动画" Style="{StaticResource GroupTitle}"/>
                        <TextBlock Text="卡片霓虹背景的节拍快慢，播放音乐时生效" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                        <DockPanel Margin="0,12,0,0" Height="26">
                            <TextBlock x:Name="NeonSpeedLabel"
                                       DockPanel.Dock="Right"
                                       Width="52"
                                       Foreground="{StaticResource TextMuted}"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"/>
                            <Slider x:Name="NeonSpeedSlider"
                                    Style="{StaticResource ModernSlider}"
                                    Minimum="400"
                                    Maximum="2000"
                                    TickFrequency="100"
                                    ValueChanged="OnNeonSpeedChanged"
                                    SmallChange="50"
                                    LargeChange="100"
                                    VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="取消" Width="86" Height="34" Margin="0,0,8,0" Click="OnCancel"
                    Background="#F0F1F4" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"/>
            <Button Content="保存" Width="86" Height="34" IsDefault="True" Click="OnSave"
                    Background="{StaticResource Accent}" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
