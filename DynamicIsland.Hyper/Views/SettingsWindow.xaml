<Window x:Class="DynamicIsland.Hyper.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hyper 灵动岛 · 设置"
        Width="380" Height="420"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontSize="13">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Hyper 灵动岛" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="DynamicIsland.Hyper · 设置" Foreground="Gray" Margin="0,2,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <TextBlock Text="主题模式" FontWeight="SemiBold" Margin="0,8,0,0"/>
            <ComboBox x:Name="ThemeModeBox" Margin="0,4,0,0">
                <ComboBoxItem Content="自动（按时间）"/>
                <ComboBoxItem Content="强制浅色"/>
                <ComboBoxItem Content="强制深色"/>
            </ComboBox>

            <TextBlock Text="日间开始时间" FontWeight="SemiBold" Margin="0,12,0,0"/>
            <ComboBox x:Name="DayStartBox" Margin="0,4,0,0"/>

            <TextBlock Text="夜间开始时间" FontWeight="SemiBold" Margin="0,12,0,0"/>
            <ComboBox x:Name="NightStartBox" Margin="0,4,0,0"/>

            <CheckBox x:Name="AutoStartCheck" Content="开机自启" Margin="0,16,0,0"/>
            <CheckBox x:Name="AutoUpdateCheck" Content="启动时检查更新" Margin="0,10,0,0"/>

            <TextBlock Text="霓虹动画速度" FontWeight="SemiBold" Margin="0,14,0,0"/>
            <DockPanel Margin="0,4,0,0">
                <TextBlock x:Name="NeonSpeedLabel"
                           DockPanel.Dock="Right"
                           Width="46"
                           Foreground="Gray"
                           TextAlignment="Right"
                           VerticalAlignment="Center"/>
                <Slider x:Name="NeonSpeedSlider"
                        Minimum="400"
                        Maximum="2000"
                        TickFrequency="100"
                        ValueChanged="OnNeonSpeedChanged"
                        SmallChange="50"
                        LargeChange="100"/>
            </DockPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Width="80" Margin="0,0,10,0" Click="OnCancel"/>
            <Button Content="保存" Width="80" IsDefault="True" Click="OnSave"/>
        </StackPanel>
    </Grid>
</Window>
