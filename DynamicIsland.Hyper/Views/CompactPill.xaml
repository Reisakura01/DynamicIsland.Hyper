<UserControl x:Class="DynamicIsland.Hyper.Views.CompactPill"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="RootBorder"
            CornerRadius="23"
            BorderThickness="1"
            Background="{DynamicResource Theme.Overlay}"
            BorderBrush="{DynamicResource Theme.Border}">
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="16,0">
            <Border x:Name="CoverBorder"
                    Width="26"
                    Height="26"
                    CornerRadius="7"
                    Background="{DynamicResource Theme.Border}"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                <Border.Clip>
                    <RectangleGeometry RadiusX="7" RadiusY="7" Rect="0,0,26,26" />
                </Border.Clip>
                <Image x:Name="CoverImage"
                       Stretch="UniformToFill" />
            </Border>
            <TextBlock x:Name="ActivityIcon"
                       Text=""
                       FontSize="13"
                       Foreground="{DynamicResource Theme.Foreground}"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="TitleText"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Theme.Foreground}"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="160" />
        </StackPanel>
    </Border>
</UserControl>
